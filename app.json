{
  "expo": {
    "name": "TongueUp",
    "slug": "tongueup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@react-native-vector-icons/lucide/fonts/Lucide.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png",
          "color": "#ffffff",
          "priority": "max",
          "defaultChannel": "default",
          "enableBackgroundNotification": true,
          "useNextNotificationsApi": true,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "fr"
            ],
            "android": [
              "en",
              "fr"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "# WorkManager (expo-background-task) instantiates its Room database by reflection; R8 full mode strips the constructor otherwise\n-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ],
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#c598d6"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE"
      ],
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "package": "com.jybenlarcher.tongueup"
    },
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "66a067f9-de91-46db-8307-39db8402567a"
      }
    },
    "experiments": {
      "reactCanary": true
    },
    "owner": "benjythebee"
  }
}
